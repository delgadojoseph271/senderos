# Copiar como .env — NUNCA commitear el .env real
MAPBOX_PUBLIC_TOKEN=YOUR_MAPBOX_TOKEN

# Laravel Sail (Docker) — backend/compose.yaml expone APP_PORT (default 80)
# Emulador Android (10.0.2.2 = localhost del host desde el emulador):
API_BASE_URL=http://10.0.2.2/api/v1
# iOS Simulator: http://127.0.0.1/api/v1
# Dispositivo físico: http://TU_IP_LAN/api/v1
# Si en backend/.env definiste APP_PORT=8000, agrega :8000 a la URL
# Producción: https://tu-api.com/api/v1
